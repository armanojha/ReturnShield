{
  "name": "@returnshield/infra",
  "version": "0.1.0",
  "private": true,
  "description": "Base AWS infrastructure: API Gateway, health Lambda, DynamoDB placeholder, CloudWatch logs.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy --require-approval broadening",
    "destroy": "cdk destroy",
    "build": "cdk synth --quiet",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "aws-cdk-lib": "2.162.1",
    "constructs": "10.3.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "aws-cdk": "2.162.1",
    "esbuild": "0.24.0",
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
