# ReturnShield environment template.
# Copy to `.env` (git-ignored) and fill in locally. Never commit real values,
# account IDs, deployed identifiers, credentials or customer data.

# --- Web application (apps/web, read at build time by Vite) ---
# Base URL of the deployed API stage, without a trailing slash.
# Local development default points at the local health dev server.
VITE_API_BASE_URL=http://localhost:3001

# Request timeout for API client calls, in milliseconds.
VITE_API_TIMEOUT_MS=8000

# --- Local health service (services/health) ---
# Port used by `npm run dev:api`.
HEALTH_PORT=3001

# Log level for structured JSON logs: debug | info | warn | error
LOG_LEVEL=info

# --- Infrastructure (infra) ---
# Logical environment name. Used for resource naming: returnshield-<env>-<resource>.
# Allowed: dev | staging | prod
RETURNSHIELD_ENV=dev

# Target AWS region. Account is taken from the active CLI profile at deploy
# time and is never stored in this repository.
AWS_REGION=us-east-1

# Named AWS CLI profile used for deployment. Credentials themselves live in the
# AWS CLI credential store, not here.
AWS_PROFILE=

# --- Smoke test (npm run smoke) ---
# Base URL to probe. Set to a real deployed stage URL to produce deployment
# evidence; leave pointed at localhost for local verification.
SMOKE_BASE_URL=http://localhost:3001
